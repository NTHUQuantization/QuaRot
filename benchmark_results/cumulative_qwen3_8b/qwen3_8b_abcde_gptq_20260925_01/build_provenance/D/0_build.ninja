ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm/bin/hipcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -g -fwrapv -O2 -Wall -g -fstack-protector-strong -Wformat -Werror=format-security -g -fwrapv -O2 -fPIC -I/workspace_root/fused_v1/quarot/kernels/include_hip -I/opt/venv/lib/python3.10/site-packages/torch/include -I/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/opt/venv/lib/python3.10/site-packages/torch/include/THH -I/opt/rocm/include -I/opt/venv/include -I/usr/include/python3.10 -c
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_HIP
cuda_cflags = -I/workspace_root/fused_v1/quarot/kernels/include_hip -I/opt/venv/lib/python3.10/site-packages/torch/include -I/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/opt/venv/lib/python3.10/site-packages/torch/include/THH -I/opt/rocm/include -I/opt/venv/include -I/usr/include/python3.10 -c
cuda_post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 -O3 -DQUAROT_BPRE_GFX12=1 -U__HIP_NO_HALF_OPERATORS__ -U__HIP_NO_HALF_CONVERSIONS__ -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_HIP --offload-arch=gfx1201 -fno-gpu-rdc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags







build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/bindings.o: compile /workspace_root/fused_v1/quarot/kernels/bindings.cpp
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/flashinfer.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/flashinfer.hip
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/fused_hip.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/fused_hip.hip
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/gemm_hip.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/gemm_hip.hip
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/quant_hip.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/quant_hip.hip
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/verification_metadata.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/verification_metadata.hip
build /workspace_root/fused_v1/build/temp.linux-x86_64-cpython-310/quarot/kernels/verification_preprocess.o: cuda_compile /workspace_root/fused_v1/quarot/kernels/verification_preprocess.hip








